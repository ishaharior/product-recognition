# Smart Product Station — environment configuration.
# Copy to `.env` at the repository root and edit. Every value shown is the default;
# an empty `.env` behaves exactly like the defaults.

# --- Server ---
APP_HOST=127.0.0.1
APP_PORT=8000
# Comma-separated browser origins allowed to call the API (the Vite dev server):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- Inference mode: baseline | custom | demo ---
INFERENCE_MODE=baseline
# Load the model at startup (set to false on slow machines / tests):
PRELOAD_MODEL=true
# Baseline weights resolved against models/ (downloaded once by ultralytics):
BASELINE_WEIGHTS=yolo11n.pt
# Custom-trained weights, relative to repo root or absolute (INFERENCE_MODE=custom):
CUSTOM_WEIGHTS=
CONFIDENCE_THRESHOLD=0.35
# Detections below this are reported as "unknown object" in the UI:
UNKNOWN_CONFIDENCE_THRESHOLD=0.50

# --- Frame handling ---
MAX_FRAME_WIDTH=640
MAX_FRAME_HEIGHT=640
MAX_INCOMING_fps=8

# --- Weight sensor: mock | serial | disabled ---
# mock   = synthetic stable readings (works without hardware)
# serial = real HX711 controller on SENSOR_PORT
SENSOR_BACKEND=mock
SENSOR_PORT=
SENSOR_BAUDRATE=9600
SENSOR_TIMEOUT_S=3.0
SENSOR_STABILITY_DELTA_G=2.0
SENSOR_STABILITY_SAMPLES=5
SENSOR_STABILITY_WINDOW_S=1.5

# --- Verification thresholds ---
VERIFY_MIN_CONFIDENCE=0.45
VERIFY_WEIGHT_TOLERANCE_PCT=10.0
VERIFY_COLOUR_MIN_SIMILARITY=0.45

# --- Demo mode ---
# Interval between synthetic demo events:
DEMO_TICK_MS=900

# --- Database ---
# SQLite file for scan history (created automatically):
DB_PATH=backend/smart_station.db

# --- Privacy ---
# Never persist camera frames (kept off by default):
STORE_FRAMES=false
